FROM robotis/ai-worker:1.3.0

ARG ROS_DISTRO=jazzy
ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive

RUN printf 'Acquire::Retries "5";\nAcquire::http::Timeout "60";\nAcquire::https::Timeout "60";\n' \
    > /etc/apt/apt.conf.d/80-retries && \
    apt-get update && \
    apt-get install -y --no-install-recommends ros-${ROS_DISTRO}-v4l2-camera v4l-utils && \
    rm -rf /var/lib/apt/lists/*

COPY ffw_bringup/launch/camera.launch.py \
    /root/ros2_ws/src/ai_worker/ffw_bringup/launch/camera.launch.py
COPY ffw_bringup/launch/camera_webcam.launch.py \
    /root/ros2_ws/src/ai_worker/ffw_bringup/launch/camera_webcam.launch.py
COPY ffw_bringup/package.xml \
    /root/ros2_ws/src/ai_worker/ffw_bringup/package.xml

COPY ffw_bringup/launch/camera.launch.py \
    /root/ros2_ws/install/ffw_bringup/share/ffw_bringup/launch/camera.launch.py
COPY ffw_bringup/launch/camera_webcam.launch.py \
    /root/ros2_ws/install/ffw_bringup/share/ffw_bringup/launch/camera_webcam.launch.py
COPY ffw_bringup/package.xml \
    /root/ros2_ws/install/ffw_bringup/share/ffw_bringup/package.xml
